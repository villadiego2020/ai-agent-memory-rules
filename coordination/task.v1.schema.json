{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared Agent Task",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "goal", "acceptance", "status", "owner", "createdAt", "updatedAt", "handoffs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^T-[0-9]{6,}$" },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "risk": { "enum": ["low", "medium", "high"] },
    "status": { "enum": ["open", "claimed", "review", "complete", "blocked"] },
    "owner": { "type": ["string", "null"] },
    "pendingOwner": { "type": ["string", "null"] },
    "ownedFiles": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "handoffs": { "type": "array", "items": { "type": "object" } },
    "review": { "type": ["object", "null"] },
    "qa": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
